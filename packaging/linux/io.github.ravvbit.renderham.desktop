# MimeType= must name exactly the formats of aic::supported_image_formats() (renderhamlib/src/image.cpp);
# the ctest "formats" checks that.
[Desktop Entry]
Type=Application
Name=renderHAM
GenericName=Amiga HAM6 image converter
Comment=Convert photos into Amiga HAM6 images and animations
Exec=renderHAMgui %f
Icon=io.github.ravvbit.renderham
Terminal=false
Categories=Graphics;2DGraphics;RasterGraphics;
Keywords=Amiga;HAM;HAM6;ILBM;IFF;image;converter;retro;
MimeType=image/png;image/jpeg;image/bmp;image/x-tga;image/gif;image/vnd.adobe.photoshop;image/x-portable-pixmap;image/x-portable-graymap;
StartupWMClass=renderHAMgui
